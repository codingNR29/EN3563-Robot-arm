  <joint name="gripper_driver" type="revolute">
    <axis xyz="0.0 0.0 1.0" />
    <limit effort="1000.0" lower="-0.5" upper="0.15" velocity="1.0" />
    <parent link="gripper_base" />
    <child link="gripper_left3" />
    <origin xyz="-0.018 0.0075 0" rpy="0 0 0" />
  </joint>
