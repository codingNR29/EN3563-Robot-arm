<?xml version="1.0"?>
<robot name="motoman_gp7">
  <!-- GP7 arm: 1:1 metres. Adaptive gripper: user-approved 1.5x CAD size
       to accommodate a 50 mm cube; this is not a manufacturer-certified gripper. -->
  <material name="yaskawa_blue">
    <color rgba="0.129 0.149 0.749 1.0" />
  </material>
  <link name="world" />
  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://gp7_description/meshes/gp7/visual/gp7_base_link.stl" scale="1 1 1" />
      </geometry>
      <material name="yaskawa_blue" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://gp7_description/meshes/gp7/collision/gp7_base_link.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0" />
    </inertial>
  </link>
  <link name="link_1_s">
