    <child link="link_1_s" />
    <origin xyz="0 0 0.33" rpy="0 0 0" />
    <axis xyz="0.0 0.0 1.0" />
    <limit lower="-2.9670" upper="2.9670" effort="212.66" velocity="6.5449" />
  </joint>
  <joint name="joint_2_l" type="revolute">
    <parent link="link_1_s" />
